# Jeoparty.io Environment Configuration Template
# Copy this file to .env and customize values for your deployment.

# Port the HTTP & WebSocket server binds to (Render, Heroku, and Docker supply this automatically)
PORT=3000

# Environment mode ('production' or 'development')
NODE_ENV=production

# Public URL of the deployed game (e.g., https://your-game-name.onrender.com)
# When set, shareable invite links and server info will prioritize this domain.
PUBLIC_URL=https://your-game-name.onrender.com

# Grace period in milliseconds before an unexpectedly disconnected host's room is terminated.
HOST_RECONNECT_GRACE_MS=15000
